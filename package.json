{
  "name": "cita-theme",
  "displayName": "Cita Theme",
  "description": "Light and dark themes in mint, pink, and navy, based on the colors of silvestar.codes.",
  "version": "0.2.0",
  "publisher": "starbist",
  "private": true,
  "author": "Silvestar Bistrović (https://www.silvestar.codes)",
  "keywords": [
    "theme",
    "color theme",
    "dark",
    "light",
    "mint",
    "navy",
    "pink"
  ],
  "homepage": "https://www.silvestar.codes",
  "bugs": {
    "url": "https://github.com/maliMirkec/vs-code-theme/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maliMirkec/vs-code-theme.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "node src/build.mjs",
    "icon": "node src/icon.mjs",
    "screenshots": "node src/screenshots.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npx @vscode/vsce package",
    "release:vsce": "npx @vscode/vsce publish",
    "release:ovsx": "npx ovsx publish"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#043A73",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Cita Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cita-dark-color-theme.json"
      },
      {
        "label": "Cita Light",
        "uiTheme": "vs",
        "path": "./themes/cita-light-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "shiki": "^4.4.3"
  }
}
